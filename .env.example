VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=lamf-chatbot.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=lamf-chatbot
VITE_FIREBASE_STORAGE_BUCKET=lamf-chatbot.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Optional: set to 1 to skip per-query embedding (keyword search only)
# SKIP_QUERY_EMBED=1
